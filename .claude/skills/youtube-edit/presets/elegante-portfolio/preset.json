{
  "name": "elegante-portfolio",
  "title": "Elegante / portfolio (Jacopo, moda)",
  "description": "Scuro caldo, serif elegante per le parole chiave, pagine del lavoro come finestre 3D con camera che si muove. Primo tipo di montaggio di Jacopo.",
  "palette_status": "confermata da Jacopo il 20/10/2026 (variante A: nero caldo, oro, smeraldo, avorio)",
  "style": {
    "font": "\"Inter\", \"Segoe UI\", system-ui, sans-serif",
    "font_faces": [
      {
        "family": "Inter",
        "file": "Inter.ttf",
        "weight": "100 900"
      },
      {
        "family": "Playfair Display",
        "file": "PlayfairDisplay-Italic.ttf",
        "weight": "400 900"
      }
    ],
    "serif": "\"Playfair Display\", Georgia, serif",
    "keyfont": "\"Playfair Display\", Georgia, serif",
    "keystyle": "italic",
    "keyweight": "500",
    "keysize": "100px",
    "text": "#f4efe6",
    "accent": "#d4af5f",
    "accent2": "#4aa585",
    "accent3": "#e9e2d2",
    "lines": {
      "size": 60,
      "weight": 600,
      "spacing": "0.005em",
      "serif_em": true,
      "serif_em_scale": 1.2
    },
    "bg": "#0b0907",
    "bg2": "#1b140d",
    "mute": "rgba(244,239,230,.62)",
    "chip": "#f4efe6",
    "chip_text": "#15100b"
  },
  "subtitles": "both",
  "formats": {
    "prefer": [
      "trail",
      "gallery",
      "orbit",
      "build",
      "annotate",
      "stats",
      "line"
    ],
    "avoid": [
      "halo",
      "chip",
      "image"
    ]
  },
  "transitions": {
    "density": "low",
    "kinds": [
      "flash",
      "whip",
      "zoomblur",
      "lightleak",
      "burn"
    ],
    "only_at": "scene-changes",
    "max_per_minute": 2
  },
  "sound": {
    "sfx": true,
    "level": "medium",
    "music": "light"
  }
}